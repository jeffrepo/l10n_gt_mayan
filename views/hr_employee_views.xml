<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.view.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']//group[@name='identification_group']" position="inside">
                <field name="allow_delete_line"/>
            </xpath>
        </field>
    </record>
</odoo>
